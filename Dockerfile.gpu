# Slim Python base plus the torch wheel, which brings the CUDA libraries as
# nvidia-* pip wheels. Several GB smaller than the pytorch/pytorch images.
# The host needs the NVIDIA driver and Container Toolkit (docker run --gpus all).
FROM python:3.11-slim

# Fixed non-root user; for bind mounts run with --user "$(id -u):$(id -g)"
RUN useradd -m -u 1000 app && install -d -o app -g app /app

WORKDIR /app

# pytorch_wavelets is pinned to a commit and installed without deps
# (its deps are in requirements-gpu.txt), from a tarball so git isn't needed.
ARG PYTORCH_WAVELETS_SHA=9a0c507f04f43c5397e384bb6be8340169b2fd9a
COPY requirements-gpu.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-gpu.txt -r requirements-dev.txt && \
    pip install --no-cache-dir --no-deps \
        "https://github.com/fbcotter/pytorch_wavelets/archive/${PYTORCH_WAVELETS_SHA}.tar.gz"

COPY --chown=app:app visualmic.py .
COPY --chown=app:app tests/ tests/
COPY --chown=app:app scripts/ scripts/

ARG VERSION
LABEL version=${VERSION}

USER app

ENTRYPOINT ["python", "-u", "visualmic.py"]
